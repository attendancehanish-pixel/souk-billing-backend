generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BILL_BOY
}

enum CustomerType {
  NORMAL
  STUDENT
}

enum BillStatus {
  PAID
  DUE
}

enum PaymentMethod {
  CASH
  GPAY
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         Role     @default(BILL_BOY)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  bills        Bill[]   @relation("BillCreator")
}

model Item {
  id        String     @id @default(cuid())
  category  String
  name      String
  price     Decimal    @db.Decimal(12, 2)
  margin    Decimal?   @db.Decimal(12, 2) // per-unit profit amount (optional)
  cost      Decimal?   @db.Decimal(12, 2) // per-unit cost (optional)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  billItems BillItem[]
}

model Student {
  id          String   @id @default(cuid())
  admissionNo String   @unique
  name        String
  className   String
  createdAt   DateTime @default(now())
  bills       Bill[]
}

model Bill {
  id            String         @id @default(cuid())
  invoiceNo     Int            @unique @default(autoincrement())
  customerType  CustomerType
  customerName  String
  studentId     String?
  student       Student?       @relation(fields: [studentId], references: [id])
  total         Decimal        @db.Decimal(12, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  status        BillStatus
  paymentMethod PaymentMethod?
  createdById   String
  createdBy     User           @relation("BillCreator", fields: [createdById], references: [id])
  isDeleted     Boolean        @default(false)
  deletedAt     DateTime?
  deletedById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         BillItem[]
  history       BillHistory[]

  @@index([createdAt])
  @@index([studentId])
}

model BillItem {
  id         String   @id @default(cuid())
  billId     String
  bill       Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  itemName   String
  category   String
  quantity   Decimal  @db.Decimal(12, 2)
  unitPrice  Decimal  @db.Decimal(12, 2)
  costAtSale Decimal? @db.Decimal(12, 2)
}

model BillHistory {
  id         String   @id @default(cuid())
  billId     String
  bill       Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  action     String // EDIT | DELETE
  editedById String
  snapshot   Json
  createdAt  DateTime @default(now())
}
